classDiagram
    direction TB

%% Data models from the src/models/ folder
    class Info {
<<model src/models/Info.js>>
+string siteName = "jnerlherms"
+string firstName = "Jon Erlo"
+string lastName = "Hermosa"
+string greeting = "Hello, I'm"
+string roleSmall = "CIT-U"
+string roleBig = "BSIT 3rd Year"
+string roleBig2 = "Student"
+string about = "3rd year IT student at CIT-U..."
+string email = "jnerlherms@gmail.com"
+string github
+string instagram
+string facebook
+string resume = "#"
}

class Project {
<<model src/models/Project.js>>
+number id
+string title
+string desc
+string tech
+string link
}

class SkillList {
<<model src/models/SkillList.js>>
+string[] skills = HTML CSS JavaScript React PHP MySQL Java Kotlin C C++
    }

%% Entry point: src/main.jsx
class Main {
<<entry src/main.jsx>>
+mount() void
}

%% The single functional component in src/App.jsx
class App {
<<component src/App.jsx>>
-string filter = "All"
-boolean showTop = false
+string[] filters = All PHP MySQL Java Kotlin
+Project[] shown = filtered subset of projects
+onScroll() void
+render() JSX
}

%% UI sections are inline JSX returned by App, not separate files
class Navbar {
<<JSX section>>
+siteName link
+links to About Projects Contact
}

class Hero {
<<JSX section>>
+greeting, name and role
+social links IG GitHub FB
+profile image
}

class AboutSection {
<<JSX section>>
+bio text
+skill chips
}

class ProjectsSection {
<<JSX section>>
+filter buttons
+project list
}

class ContactSection {
<<JSX section>>
+mailto email link
    }

class BackToTop {
<<JSX section>>
+shown only when showTop is true
+link to #home
}

class FooterSection {
<<JSX section>>
+copyright text
}

